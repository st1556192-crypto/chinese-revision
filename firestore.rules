rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/mistakes/{idiomId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/practiceSessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
